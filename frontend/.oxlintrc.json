{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-hooks"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error"
  },
  "jsPlugins": [
    {
      "name": "bazarr-custom",
      "specifier": "./oxlint-plugins/bazarr-custom.ts"
    }
  ],
  "ignorePatterns": [
    "dist",
    "build",
    "coverage",
    "node_modules",
    "dev-dist",
    ".husky",
    "vite.config.ts"
  ],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true,
        "allowCompoundComponents": true,
        "customHOCs": ["withModal"]
      }
    ],
    "no-console": "error",
    "bazarr-custom/camelcase": "error",
    "no-restricted-imports": ["error", { "patterns": ["../*"] }],
    "no-empty-function": "error",
    "no-unused-expressions": "error",
    "no-unused-vars": "error",
    "no-useless-rename": "error",
    "bazarr-custom/no-let": "error",
    "bazarr-custom/no-function-declaration": "error",
    "bazarr-custom/no-cross-module-scss-import": "error"
  },
  "overrides": [
    {
      "files": [
        "src/components/index.tsx",
        "src/pages/Settings/components/index.tsx",
        "src/tests/index.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "**/__tests__/**/*.{js,jsx,ts,tsx}",
        "**/*.{test,spec}.{js,jsx,ts,tsx}"
      ],
      "plugins": ["react", "react-hooks", "typescript"],
      "rules": {
        "typescript/no-floating-promises": "error",
        "typescript/await-thenable": "error",
        "bazarr-custom/no-wait-for-side-effects": "error"
      }
    }
  ]
}
