{
  "name": "bazarr",
  "version": "1.0.0",
  "description": "Bazarr is a companion application to Sonarr and Radarr. It manages and downloads subtitles based on your requirements. You define your preferences by TV show or movie and Bazarr takes care of everything for you.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morpheus65535/bazarr.git"
  },
  "author": "morpheus65535",
  "license": "GPL-3",
  "bugs": {
    "url": "https://github.com/morpheus65535/bazarr/issues"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@mantine/core": "^9.8.2",
    "@mantine/dropzone": "^9.8.2",
    "@mantine/form": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/modals": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@mantine/spotlight": "^9.8.2",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-table": "^9.2.4",
    "axios": "^1.21.1",
    "braces": "^3.0.3",
    "defu": "^6.1.6",
    "dompurify": "^3.5.0",
    "fast-uri": "^4.2.4",
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.3",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.19",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.3",
    "react-timeago": "^8.3.0",
    "rollup": "^4.68.8",
    "socket.io-client": "^4.8.3",
    "socket.io-parser": "^4.2.6",
    "workbox-build": "^7.4.1"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/ui": "^5.1.2",
    "clsx": "^2.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.3",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lodash": "^4.18.1",
    "msw": "^3.0.8",
    "oxlint": "^1.95.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "pretty-quick": "^4.2.2",
    "sass-embedded": "^1.108.2",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-checker": "^1.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "build": "vite build",
    "build:ci": "vite build -m development",
    "check": "oxlint src",
    "check:fix": "oxlint src --fix",
    "check:ts": "tsc --noEmit --incremental false",
    "check:fmt": "prettier -c .",
    "check:style": "stylelint \"src/**/*.{css,scss}\" --max-warnings 0",
    "check:style:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "coverage": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' vitest run --coverage",
    "format": "prettier -w .",
    "pwa-assets:generate": "pwa-assets-generator --preset minimal-2023 public/images/logo128.png",
    "prepare": "cd .. && husky frontend/.husky",
    "preview": "vite preview",
    "start": "vite",
    "test": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' vitest",
    "test:ui": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' vitest --ui"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "serialize-javascript": "^7.0.4",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@vite-pwa/assets-generator": {
      "sharp": "^0.35.4"
    }
  }
}
